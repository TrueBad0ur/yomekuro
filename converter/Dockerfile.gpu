# syntax=docker/dockerfile:1
# AMD ROCm GPU version — amd64 only, requires a ROCm-capable host (amdgpu kernel
# driver + /dev/kfd + /dev/dri passthrough). No NVIDIA/CUDA support.
FROM golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
# go.mod's "replace ... => ../shared" resolves to /shared, one level above
# WORKDIR — populated from a separate build context so this Dockerfile stays
# buildable with converter/ as its context root (see docker-compose.yml's
# additional_contexts / the --build-context flag in build commands).
COPY --from=shared . /shared
RUN go mod download
COPY *.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /converter .

FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libnuma1 \
        libjxl-tools \
        poppler-utils \
        poppler-data \
    && rm -rf /var/lib/apt/lists/*

# Missing PCI-ID file makes libdrm log a harmless warning on every startup;
# empty placeholder silences it (used only for pretty-printing GPU names).
RUN mkdir -p /opt/amdgpu/share/libdrm && touch /opt/amdgpu/share/libdrm/amdgpu.ids

# Silence "sending unauthenticated requests to the HF Hub" — we don't need a
# token for the public manga-ocr-base model, just the rate limits it warns about.
ENV HF_HUB_VERBOSITY=error

# Without libnuma1, HSA agent init fails silently instead of raising an error.
# Install before mokuro to prevent pip pulling default CUDA torch.
RUN pip install --no-cache-dir \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/rocm6.4

COPY mokuro/ /mokuro/
# Pin the transformers version validated with manga-ocr-base.
RUN pip install --no-cache-dir /mokuro sentencepiece "transformers==5.21.1" && \
    cp -r /mokuro/mokuro/assets \
      "$(python3 -c 'import importlib.util,pathlib; print(pathlib.Path(importlib.util.find_spec("mokuro").origin).parent)')"

# Only the textline-merge piece of manga-image-translator (see mokuro_run.py's
# GraphMangaPageOcr for why) — not the full package, whose own __init__.py
# chain pulls in unrelated translator/inpainting/rendering deps we don't want.
# mit_shim/ supplies our own minimal __init__.py files; the actual algorithm
# files come from the submodule. GPL-3.0 (see converter/LICENSE) — this is why
# it's kept to these four files instead of e.g. installing the whole package.
RUN pip install --no-cache-dir einops py3langid requests
COPY mit_shim/manga_translator/ /mit/manga_translator/
COPY manga-image-translator/manga_translator/utils/generic.py /mit/manga_translator/utils/generic.py
COPY manga-image-translator/manga_translator/utils/generic2.py /mit/manga_translator/utils/generic2.py
COPY manga-image-translator/manga_translator/utils/textblock.py /mit/manga_translator/utils/textblock.py
COPY manga-image-translator/manga_translator/textline_merge/__init__.py /mit/manga_translator/textline_merge/__init__.py

COPY mokuro_run.py /mokuro_run.py
COPY --from=builder /converter /converter
ENTRYPOINT ["/converter"]
